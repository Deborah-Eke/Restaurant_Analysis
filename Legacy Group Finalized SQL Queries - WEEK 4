---I. calculation of distinct customer days---
SELECT
    COUNT(*) AS order_lines,
    COUNT(DISTINCT customer_id) AS customers,
    COUNT(DISTINCT order_date) AS dates,
    COUNT(DISTINCT CONCAT(customer_id, '|', order_date)) AS customer_days
FROM Restaurant_orders;

---II.calculation of distinct menu items---
SELECT
    customer_id,
    order_date,
    COUNT(*) AS order_line_count,
    COUNT(DISTINCT order_id) AS order_count,
    COUNT(DISTINCT menu_item) AS distinct_menu_items
FROM restaurant_orders
GROUP BY customer_id, order_date
HAVING COUNT(*) > 1
ORDER BY order_date, customer_id;

--III. Keep each item pair only once per customer and date---
WITH customer_day_items AS (
    SELECT DISTINCT
        customer_id,
        order_date,
        menu_item
    FROM restaurant_orders
    WHERE customer_id IS NOT NULL
      AND order_date IS NOT NULL
      AND menu_item IS NOT NULL
),

same_day_pairs AS (
    SELECT
        a.customer_id,
        a.order_date,
        a.menu_item AS item_a,
        b.menu_item AS item_b
    FROM customer_day_items AS a
    INNER JOIN customer_day_items AS b
        ON a.customer_id = b.customer_id
       AND a.order_date = b.order_date
       AND a.menu_item < b.menu_item
)

SELECT
    customer_id,
    order_date,
    item_a,
    item_b
FROM same_day_pairs
ORDER BY order_date, customer_id, item_a, item_b;

SELECT
    item_a,
    item_b,
    COUNT(*) AS pair_occurrences,
    COUNT(DISTINCT customer_id) AS distinct_customers,
    COUNT(DISTINCT order_date) AS distinct_dates
FROM same_day_pairs
GROUP BY item_a, item_b
ORDER BY pair_occurrences DESC, item_a, item_b;

WITH customer_day_items AS (
    SELECT DISTINCT
        customer_id,
        order_date,
        menu_item
    FROM orders
    WHERE customer_id IS NOT NULL
      AND order_date IS NOT NULL
      AND menu_item IS NOT NULL
),

same_day_pairs AS (
    SELECT
        a.customer_id,
        a.order_date,
        a.menu_item AS item_a,
        b.menu_item AS item_b
    FROM customer_day_items AS a
    INNER JOIN customer_day_items AS b
        ON a.customer_id = b.customer_id
       AND a.order_date = b.order_date
       AND a.menu_item < b.menu_item
)

SELECT
    p.customer_id,
    p.order_date,
    p.item_a,
    p.item_b,
    COUNT(DISTINCT o.order_id) AS order_count,
    STRING_AGG(DISTINCT CAST(o.order_id AS VARCHAR), ', ')
        AS order_ids
FROM same_day_pairs AS p
INNER JOIN orders AS o
    ON o.customer_id = p.customer_id
   AND o.order_date = p.order_date
GROUP BY
    p.customer_id,
    p.order_date,
    p.item_a,
    p.item_b
ORDER BY p.order_date, p.customer_id;

SELECT
    customer_id,
    order_date,
    menu_item,
    COUNT(*) AS line_count,
    SUM(quantity) AS total_quantity
FROM restaurant_orders
GROUP BY customer_id, order_date, menu_item
HAVING COUNT(*) > 1
