---6. Loyalty Rate for Discounted vs Full Price Orders---

SELECT
    CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END AS Order_Type,
    COUNT(*) AS Total_Orders,
    SUM(
        CASE
            WHEN Customer_Segment = 'Loyal' THEN 1
