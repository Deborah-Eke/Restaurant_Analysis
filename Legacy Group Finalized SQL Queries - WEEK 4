---Creating the Clean Dataset---
WITH CleanedData As
(
SELECT *,
ROW_NUMBER() OVER
(
PARTITION BY Transaction_ID
ORDER BY Transaction_ID
) AS RowNumber
FROM team_oreo_restaurant_internship_dataset
)
SELECT *
INTO team_oreo_restaurant_internship_dataset_Cleaned
FROM CleanedData
WHERE RowNumber = 1;

