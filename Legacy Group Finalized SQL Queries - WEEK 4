---DISCOUNTS, REVENUE OPPORTUNITY AND KPI SUMMARY---

---1. Discounted vs Full Price Orders---

SELECT
COUNT(*) AS Order_Count,
  CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END AS Order_Type,
    SUM(Quantity) AS Total_Quantity,
    ROUND(AVG(Net_Sales_GBP), 2) AS Average_Order_Value,
    ROUND(AVG(Quantity), 2) AS Average_Quantity,
    ROUND(AVG(Customer_Rating), 2) AS Average_Rating,
    ROUND(SUM(Discount_Value_GBP), 2) AS Total_Discount_Cost,
    ROUND(SUM(Net_Sales_GBP), 2) AS Total_Net_Sales
FROM resturant_orders
GROUP BY
    CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END;

---2. Performance at Different Discount Levels---

SELECT
    Discount_Percent,
    COUNT(*) AS Order_Count,
    SUM(Quantity) AS Total_Quantity,
    ROUND(AVG(Quantity), 2) AS Average_Quantity,
    ROUND(AVG(Net_Sales_GBP), 2) AS Average_Order_Value,
    ROUND(SUM(Net_Sales_GBP), 2) AS Total_Net_Sales,
    ROUND(SUM(Discount_Value_GBP), 2) AS Total_Discount_Cost,
    ROUND(AVG(Customer_Rating), 2) AS Average_Rating
FROM restaurant_orders
GROUP BY Discount_Percent
ORDER BY Discount_Percent;

---3. Discount Cost Compared with Sales---

SELECT
    CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END AS Order_Type,
    ROUND(SUM(Gross_Sales_GBP), 2) AS Gross_Sales,
    ROUND(SUM(Discount_Value_GBP), 2) AS Discount_Cost,
    ROUND(SUM(Net_Sales_GBP), 2) AS Net_Sales,
    ROUND(
        SUM(Discount_Value_GBP) /
        NULLIF(SUM(Gross_Sales_GBP), 0) * 100, 2
    ) AS Discount_Percentage,
    ROUND(SUM(Gross_Profit_GBP), 2) AS Gross_Profit
FROM restaurant_orders
GROUP BY
    CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END;

---4. Discounted vs Full Price Profitability---

SELECT
    CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END AS Order_Type,
    COUNT(*) AS Order_Count,
    ROUND(SUM(Net_Sales_GBP), 2) AS Net_Sales,
    ROUND(SUM(Food_Cost_GBP), 2) AS Food_Cost,
    ROUND(SUM(Gross_Profit_GBP), 2) AS Gross_Profit,
    ROUND(
        SUM(Gross_Profit_GBP) /
        NULLIF(SUM(Net_Sales_GBP), 0) * 100, 2
    ) AS Gross_Profit_Margin
FROM restaurant_orders
GROUP BY
    CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END;

---5. Discounted vs Full Price by Customer Segment---

SELECT
    CASE
        WHEN Discount_Percent > 0 THEN 'Discounted'
        ELSE 'Full Price'
    END AS Order_Type,
    Customer_Segment,
    COUNT(*) AS Order_Count,
    ROUND(SUM(Net_Sales_GBP), 2) AS Net_Sales,
    ROUND(AVG(Customer_Rating), 2) AS Average_Rating
