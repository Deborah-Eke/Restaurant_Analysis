---11. High Revenue Products with High Waste---

SELECT
    Menu_Item,
    Unit_Price_GBP,
    SUM(Quantity) AS Units_Sold,
    ROUND(SUM(Net_Sales_GBP), 2) AS Revenue,
    ROUND(SUM(Waste_Cost_GBP), 2) AS Waste_Cost,
    ROUND(SUM(Gross_Profit_GBP), 2) AS Gross_Profit,
    ROUND(
        SUM(Waste_Cost_GBP) /
        NULLIF(SUM(Net_Sales_GBP), 0) * 100,
        2
    ) AS Waste_Percentage
FROM restaurant_orders
GROUP BY
    Menu_Item,
    Unit_Price_GBP
HAVING
    SUM(Net_Sales_GBP) >
    (
        SELECT AVG(Product_Revenue)
        FROM
        (
            SELECT
                Menu_Item,
                SUM(Net_Sales_GBP) AS Product_Revenue
            FROM cleaned_team_oreo
            GROUP BY Menu_Item
        ) AS ProductSummary
    )
    AND SUM(Waste_Cost_GBP) > 0
ORDER BY
    Waste_Percentage DESC;

---12. Revenue Share by Price Tier---

WITH TierRevenue AS
(
    SELECT
        CASE
            WHEN Unit_Price_GBP <= 5 THEN 'Budget'
            WHEN Unit_Price_GBP <= 10 THEN 'Mid'
            ELSE 'Premium'
        END AS Price_Tier,
        SUM(Net_Sales_GBP) AS Revenue
    FROM restaurant_orders
    GROUP BY
        CASE
            WHEN Unit_Price_GBP <= 5 THEN 'Budget'
            WHEN Unit_Price_GBP <= 10 THEN 'Mid'
            ELSE 'Premium'
        END
)

SELECT
    Price_Tier,
    ROUND(Revenue, 2) AS Revenue,
    ROUND(
        Revenue /
        NULLIF((SELECT SUM(Revenue) FROM TierRevenue), 0) * 100,
        2
    ) AS Revenue_Share_Percentage
FROM TierRevenue
ORDER BY
    Revenue DESC;

---13. Waste Share by Price Tier---

WITH TierWaste AS

    SELECT
        CASE
            WHEN Unit_Price_GBP <= 5 THEN 'Budget'
            WHEN Unit_Price_GBP <= 10 THEN 'Mid'
            ELSE 'Premium'
        END AS Price_Tier,
        SUM(Waste_Cost_GBP) AS Waste_Cost
    FROM restaurant_orders
    GROUP BY
        CASE
            WHEN Unit_Price_GBP <= 5 THEN 'Budget'
            WHEN Unit_Price_GBP <= 10 THEN 'Mid'
            ELSE 'Premium'
        END
)

SELECT
    Price_Tier,
    ROUND(Waste_Cost, 2) AS Waste_Cost,
    ROUND(
        Waste_Cost /
        NULLIF((SELECT SUM(Waste_Cost) FROM TierWaste), 0) * 100,
        2
    ) AS Waste_Share_Percentage
FROM TierWaste
ORDER BY
    Waste_Cost DESC;

---14. Revenue vs Waste Opportunity---

SELECT
    Menu_Item,
    Unit_Price_GBP,
    CASE
        WHEN Unit_Price_GBP <= 5 THEN 'Budget'
        WHEN Unit_Price_GBP <= 10 THEN 'Mid'
        ELSE 'Premium'
    END AS Price_Tier,
    SUM(Quantity) AS Units_Sold,
    ROUND(SUM(Net_Sales_GBP), 2) AS Revenue,
    ROUND(SUM(Waste_Cost_GBP), 2) AS Waste_Cost,
    ROUND(SUM(Gross_Profit_GBP), 2) AS Gross_Profit,
    ROUND(
        SUM(Waste_Cost_GBP) /
        NULLIF(SUM(Net_Sales_GBP), 0) * 100,
        2
    ) AS Waste_Percentage
FROM restaurant_orders
GROUP BY
    Menu_Item,
    Unit_Price_GBP
ORDER BY
    Waste_Percentage DESC;


----KPI Summary----
SELECT
  /* Period */
  MIN(Order_Date)                                         AS period_start,
  MAX(Order_Date)                                         AS period_end,

  /* Sales */
  ROUND(SUM(Net_Sales_GBP), 2)                            AS net_sales,
  ROUND(SUM(Gross_Sales_GBP), 2)                          AS gross_sales,
  COUNT(DISTINCT Order_ID)                                AS orders,
  ROUND(SUM(Net_Sales_GBP) * 1.0
        / COUNT(DISTINCT Order_ID), 2)                    AS aov,
  SUM(Quantity)                                           AS items_sold,

  /* Profit */
  ROUND(SUM(Food_Cost_GBP), 2)                            AS food_cost,
  ROUND(SUM(Gross_Profit_GBP), 2)                         AS gross_profit,
  ROUND(SUM(Gross_Profit_GBP) * 100.0
        / SUM(Net_Sales_GBP), 1)                          AS gross_margin_pct,

  /* Discounts */
  ROUND(SUM(Discount_Value_GBP), 2)                       AS discount_cost,
  ROUND(SUM(Discount_Value_GBP) * 100.0
        / SUM(Gross_Sales_GBP), 1)                        AS discount_pct_of_gross,
  ROUND(SUM(CASE WHEN Discount_Value_GBP > 0 THEN 1 ELSE 0 END)
        * 100.0 / COUNT(DISTINCT Order_ID), 1)            AS orders_with_discount_pct,
  ROUND(AVG(CASE WHEN Discount_Percent > 0
                 THEN Discount_Percent END), 1)           AS avg_discount_when_applied_pct,

  /* Waste */
  ROUND(SUM(Waste_Cost_GBP), 2)                           AS waste_cost,
  ROUND(SUM(Waste_Cost_GBP) * 100.0
        / SUM(Net_Sales_GBP), 1)                          AS waste_pct_of_net_sales,
  ROUND(SUM(Waste_Cost_GBP) * 100.0
        / SUM(Food_Cost_GBP), 1)                          AS waste_pct_of_food_cost,
  SUM(Waste_Quantity)                                     AS units_wasted,
  ROUND(SUM(CASE WHEN Waste_Cost_GBP > 0 THEN 1 ELSE 0 END)
        * 100.0 / COUNT(DISTINCT Order_ID), 1)            AS orders_with_waste_pct,

  /* Customer experience */
  SUM(CASE WHEN Complaint_Received = 'Yes' THEN 1 ELSE 0 END)  AS complaints,
  ROUND(SUM(CASE WHEN Complaint_Received = 'Yes' THEN 1 ELSE 0 END)
        * 100.0 / COUNT(DISTINCT Order_ID), 1)            AS complaint_rate_pct,
  ROUND(AVG(Customer_Rating), 2)                          AS avg_rating,
  ROUND(AVG(Preparation_Time_Min), 1)                     AS avg_prep_time_min
FROM restaurant_orders;

SELECT
  Order_Channel                                           AS channel,
  ROUND(SUM(Net_Sales_GBP), 2)                            AS net_sales,
  COUNT(DISTINCT Order_ID)                                AS orders,
  ROUND(SUM(Net_Sales_GBP) * 1.0
        / COUNT(DISTINCT Order_ID), 2)                    AS aov,
  ROUND(SUM(CASE WHEN Complaint_Received = 'Yes' THEN 1 ELSE 0 END)
        * 100.0 / COUNT(DISTINCT Order_ID), 1)            AS complaint_rate_pct,
  ROUND(SUM(Waste_Cost_GBP), 2)                           AS waste_cost
FROM restaurant_orders
GROUP BY Order_Channel
ORDER BY net_sales DESC;






