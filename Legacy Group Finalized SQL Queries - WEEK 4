---Recalculating the Discount Value---
UPDATE team_oreo_restaurant_internship_dataset_Cleaned
SET Discount_Value_GBP =
ROUND(
(Quantity * Unit_Price_GBP * Discount_Percent)/ 100,
2);

---Recalculating the Net Sales---
UPDATE team_oreo_restaurant_internship_dataset_Cleaned
SET Net_Sales_GBP =
ROUND(
(Quantity * Unit_Price_GBP) - Discount_Value_GBP,
2);

