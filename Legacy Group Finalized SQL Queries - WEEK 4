---3. Products to Investigate--- 
SELECT
    Menu_Item,
    COUNT(*) AS Total_Transactions,
    SUM(
        CASE
            WHEN Complaint_Received = 'Yes' THEN 1
            ELSE 0
        END
    ) AS Complaints,
    ROUND(
        SUM(
            CASE
                WHEN Complaint_Received = 'Yes' THEN 1
                ELSE 0
            END
        ) / COUNT(*) * 100,
        2
    ) AS Complaint_Rate_Pct,

    ROUND(AVG(Customer_Rating), 2) AS Average_Rating,
    ROUND(SUM(Waste_Cost_GBP), 2) AS Waste_Cost_GBP,

    CASE
        WHEN
            (
                SUM(
                    CASE
                        WHEN Complaint_Received = 'Yes' THEN 1
                        ELSE 0
                    END
                ) / COUNT(*) * 100
            ) >= 5
            AND AVG(Customer_Rating) >= 4
            AND SUM(Waste_Cost_GBP) = 0
        THEN 'Investigate - High Complaints Despite Good Rating and No Waste'
        WHEN
            (
                SUM(
                    CASE
                        WHEN Complaint_Received = 'Yes' THEN 1
                        ELSE 0
                    END
                ) / COUNT(*) * 100
            ) >= 5
        THEN 'Investigate - High Complaint Rate'
        ELSE 'Lower Complaint Concern'
    END AS Investigation_Flag
FROM [Week - 4 build up]
GROUP BY Menu_Item
ORDER BY Complaint_Rate_Pct DESC;


---CUSTOMER PATTERNS AND SQL LEAD---

---1. Order Frequency Band and Average Lifetime Spend---

WITH customer_summary AS (
    SELECT
        Customer_ID,
        COUNT(DISTINCT Order_ID) AS Order_Count,
        SUM(Net_Sales_GBP) AS Lifetime_Spend
    FROM restaurant_orders
    GROUP BY Customer_ID
)
SELECT
    CASE
        WHEN Order_Count = 1 THEN '1 order'
        WHEN Order_Count BETWEEN 2 AND 3 THEN '2-3 orders'
        WHEN Order_Count BETWEEN 4 AND 6 THEN '4-6 orders'
        WHEN Order_Count >= 7 THEN '7+ orders'
    END AS Order_Frequency_Band,
    COUNT(*) AS Number_of_Customers,
    ROUND(AVG(Lifetime_Spend), 2) AS Average_Lifetime_Spend_GBP
FROM customer_summary
GROUP BY
    CASE
        WHEN Order_Count = 1 THEN '1 order'
        WHEN Order_Count BETWEEN 2 AND 3 THEN '2-3 orders'
        WHEN Order_Count BETWEEN 4 AND 6 THEN '4-6 orders'
        WHEN Order_Count >= 7 THEN '7+ orders'
    END
ORDER BY Average_Lifetime_Spend_GBP DESC;


---2. Customer Segment Stability Check---

WITH order_level AS (
    SELECT
        Customer_ID,
        Order_ID,
        MIN(Customer_Segment) AS Order_Segment
    FROM restaurant_orders
    GROUP BY Customer_ID, Order_ID
),

segment_counts AS (
    SELECT
        Customer_ID,
        COUNT(DISTINCT Order_Segment) AS Distinct_Segments
    FROM order_level
    GROUP BY Customer_ID
)

SELECT
    CASE
        WHEN Distinct_Segments = 1 THEN 'Stable'
        ELSE 'Changed'
    END AS Segment_Stability,
    COUNT(*) AS Num_Customers
FROM segment_counts
GROUP BY Distinct_segment;


