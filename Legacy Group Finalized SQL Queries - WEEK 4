---8. Revenue and Waste by Price Tier---

WITH PriceTierData AS
(
    SELECT
        Order_ID,
        Quantity,
        Unit_Price_GBP,
        Net_Sales_GBP,
        Food_Cost_GBP,
        Waste_Cost_GBP,
        Gross_Profit_GBP,
        CASE
            WHEN Unit_Price_GBP <= 5 THEN 'Budget'
            WHEN Unit_Price_GBP <= 10 THEN 'Mid'
            ELSE 'Premium'
        END AS Price_Tier
    FROM restaurant_orders
)

SELECT
    Price_Tier,
    COUNT(DISTINCT Order_ID) AS Order_Count,
    SUM(Quantity) AS Total_Units_Sold,
    ROUND(SUM(Net_Sales_GBP), 2) AS Total_Revenue,
    ROUND(SUM(Food_Cost_GBP), 2) AS Total_Food_Cost,
    ROUND(SUM(Waste_Cost_GBP), 2) AS Total_Waste_Cost,
    ROUND(SUM(Gross_Profit_GBP), 2) AS Total_Gross_Profit,
    ROUND(
        SUM(Waste_Cost_GBP) /
        NULLIF(SUM(Net_Sales_GBP), 0) * 100,
        2
    ) AS Waste_Percentage,
    ROUND(
        SUM(Gross_Profit_GBP) /
        NULLIF(SUM(Net_Sales_GBP), 0) * 100,
        2
    ) AS Gross_Profit_Margin
FROM PriceTierData
GROUP BY Price_Tier
ORDER BY
    CASE
        WHEN Price_Tier = 'Budget' THEN 1
        WHEN Price_Tier = 'Mid' THEN 2
        WHEN Price_Tier = 'Premium' THEN 3
    END;

